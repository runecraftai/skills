{
  "name": "@runecraft/grimoire",
  "version": "1.1.0",
  "description": "Interactive catalog and installer for agent skills",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "grimoire": "dist/grimoire.js"
  },
  "files": [
    "skills/",
    "references/",
    "dist/",
    "catalog.json"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=node --format=esm --outfile dist/grimoire.js && chmod +x dist/grimoire.js",
    "dev": "bun run src/index.ts",
    "lint": "bun run typecheck",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "grimoire",
    "agent",
    "skills",
    "prompts",
    "ai",
    "coding-agent",
    "claude",
    "codex",
    "opencode",
    "copilot",
    "installer",
    "cli"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}

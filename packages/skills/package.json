{
  "name": "@runecraft/grimoire",
  "version": "2.0.0",
  "description": "Full-screen catalog and installer for agent skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/runecraftai/skills.git",
    "directory": "packages/skills"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.4.0",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "grimoire": "dist/grimoire.js"
  },
  "files": [
    "skills/",
    "catalog/",
    "references/",
    "dist/",
    "catalog.json"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=node --format=esm --outfile dist/grimoire.js && chmod +x dist/grimoire.js",
    "dev": "bun run src/index.ts",
    "lint": "bun run typecheck",
    "test": "bun test",
    "catalog:generate": "bun run scripts/generate-catalog.ts",
    "catalog:release:build": "bun run scripts/build-release-catalog.ts",
    "catalog:release:verify": "bun run scripts/verify-published-catalog.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "grimoire",
    "agent",
    "skills",
    "prompts",
    "ai",
    "coding-agent",
    "claude",
    "codex",
    "opencode",
    "copilot",
    "installer",
    "cli"
  ],
  "dependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.14",
    "typescript": "^7.0.2"
  }
}
